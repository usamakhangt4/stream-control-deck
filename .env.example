# ============================================================================
# Stream Control Deck — Developer Credentials (.env)
# ============================================================================
# Copy this file to `.env` and fill in YOUR OWN app credentials.
# `.env` is git-ignored; never commit real secrets.
#
# These are the developer credentials for your registered apps. They power the
# "Connect" buttons in the Settings modal — users just click Connect and go
# through the provider's OAuth login, which mints per-user tokens automatically.
#
# NOTE: Vite exposes `VITE_`-prefixed vars to the browser bundle. This app is
# fully client-side, so these values are technically visible in the published
# JS. That's acceptable for a personal/private deploy; for a public deploy,
# prefer OAuth flows that don't require shipping a client secret (e.g. PKCE).
# ============================================================================

# --- Twitch (https://dev.twitch.tv/console/apps) ---------------------------
VITE_TWITCH_CLIENT_ID=
# Twitch requires 2FA on the account that registers the app.

# --- Kick (https://app.kick.com/developer) ---------------------------------
VITE_KICK_CLIENT_ID=
VITE_KICK_CLIENT_SECRET=

# --- YouTube / Google (https://console.cloud.google.com/apis/credentials) --
VITE_YOUTUBE_CLIENT_ID=
VITE_YOUTUBE_CLIENT_SECRET=
